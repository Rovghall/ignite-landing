# Set this on Vercel (Production) to show Coming Soon + password gate.
# Leave empty locally to browse the full site without a password.
SITE_PASSWORD=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase (same project as the mobile app) — used by /internal/rc-payouts-ignite
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
